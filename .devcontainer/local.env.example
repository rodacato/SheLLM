# Copy to .devcontainer/local.env (gitignored) to reach your server from the
# devcontainer, then rebuild the container. See .devcontainer/README.md.
#
# Only what cannot be derived. GITHUB_REPOSITORY, GITHUB_REPOSITORY_OWNER,
# GITHUB_ACTOR and GH_TOKEN come from the host through initialize.sh; a value
# set here overrides it.
#
# No production secrets: never SHELLM_ADMIN_PASSWORD, a client key or a
# provider token. A compromised container would hand over production.

# The server SheLLM runs on, for `ssh "$HOST_IP"` and scripts/setup/vps.sh.
HOST_IP=
