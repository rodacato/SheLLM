# SheLLM configuration — the live copy is ~/.config/shellm/env (mode 600), written by `shellm init`.
# Nothing reads this file at runtime, with one exception: the dev container installs a copy of it
# as that config when none exists, and every secret here is commented out, so `shellm init` is
# still what makes /admin/* answer.
#
# GENERATED by `npm run config:build` from src/config/schema.js. Edit the schema, not this file.

# --- Server ---

# Port the HTTP server listens on
PORT=6100

# Interface to bind. Loopback keeps SheLLM reachable only through a local tunnel or proxy.
HOST=127.0.0.1

# Log level: debug, info, warn, error
LOG_LEVEL=info

# IANA timezone the admin dashboard renders every timestamp in — tables, charts and axis
# labels. Server logs stay UTC. An unknown name falls back to the default instead of failing.
# SHELLM_TZ=America/Mexico_City

# Origins allowed to call /v1 from a browser, comma-separated. Empty disables CORS
# entirely, which is the default. Exact match — scheme, host and port, no path, no trailing
# slash, and no wildcard. The admin endpoints are never included. See "Using SheLLM from a
# browser" in README.md.
# SHELLM_CORS_ORIGINS=https://you.github.io,http://localhost:5173

# Serve HTTPS instead of plain HTTP. Both this and SHELLM_TLS_KEY are needed; either
# alone is ignored. HTTP/1.1 only — for HTTP/2 put Caddy in front, as the README describes.
# SHELLM_TLS_CERT=/etc/shellm/tls/cert.pem

# Private key for SHELLM_TLS_CERT. Ignored unless both are set.
# SHELLM_TLS_KEY=/etc/shellm/tls/key.pem

# Trust X-Forwarded-* when something really does sit in front: "loopback", a hop count,
# or the proxy's address. Off by default, because otherwise a caller can forge its own IP and
# the admin login lockout counts the wrong one.
# SHELLM_TRUST_PROXY=loopback

# --- Providers ---

# Long-lived Claude token from `claude setup-token`. Optional when the CLI is logged in for this
# user.
# CLAUDE_CODE_OAUTH_TOKEN=

# Max time (ms) to wait for a CLI process before killing it
TIMEOUT_MS=120000

# Claude runs with --dangerously-skip-permissions so it never waits for a prompt. Set to
# false to remove the flag (a tool request will then hang until the timeout).
# SHELLM_CLAUDE_SKIP_PERMISSIONS=true

# --- Load ---

# Max CLI processes running at the same time. Requests beyond this wait in the queue;
# it limits subprocess spawns, not Express.
MAX_CONCURRENT=4

# Max requests waiting when every slot is busy. Beyond this, requests get HTTP 429.
MAX_QUEUE_DEPTH=10

# Max concurrent streaming responses
# MAX_STREAM_CONCURRENT=4

# Global rate limit across all API keys, requests per minute
# SHELLM_GLOBAL_RPM=60

# Largest request body /v1/chat/completions accepts, in bytes, where images arrive as
# base64. It is read only after the key is checked; every other endpoint stays at 256 kB.
# SHELLM_MAX_CHAT_BODY_BYTES=20971520

# Most images one /v1/chat/completions request may carry. 0 turns images off.
# SHELLM_MAX_IMAGES=8

# Largest image accepted, in decoded bytes. Claude downsizes anything over about 1568 px
# on its long edge, so resizing before sending costs nothing and saves the upload.
# SHELLM_MAX_IMAGE_BYTES=5242880

# --- Auth ---

# Admin password for /admin/* and the dashboard login (generated by `shellm init`).
# When unset, every admin endpoint returns 501.
# SHELLM_ADMIN_PASSWORD=

# Only this username is accepted when set; otherwise any username with the right password works.
# SHELLM_ADMIN_USER=admin

# Failed admin logins per IP before a 5-minute lockout
# SHELLM_ADMIN_MAX_ATTEMPTS=5

# Reject /v1/* requests when no API key exists, instead of running unauthenticated
# SHELLM_REQUIRE_AUTH=true

# HMAC secret for API key hashing. Auto-generated and stored in the database when unset;
# set it explicitly only to keep keys valid across a restore into a different database.
# SHELLM_HMAC_SECRET=

# --- Health and alerts ---

# How long (ms) provider health results are cached before re-probing
HEALTH_CACHE_TTL_MS=30000

# How often (ms) the background poller runs `--version` checks. Spends no quota.
# HEALTH_POLL_INTERVAL_MS=300000

# POST alerts (provider health transitions, auth failure spikes) to Slack, Discord, Uptime Kuma…
# SHELLM_ALERT_WEBHOOK_URL=

# Auth failures in one minute before the webhook fires
# SHELLM_AUTH_ALERT_THRESHOLD=10

# --- Routing (off by default) ---

# Retry a failed request on another provider, in priority order. Off unless set to true.
# SHELLM_FALLBACK_ENABLED=false

# The provider priority order fallback walks. Ignored while SHELLM_FALLBACK_ENABLED is off.
# SHELLM_FALLBACK_ORDER=claude,codex

# Consecutive failures before a provider's circuit opens
# CIRCUIT_BREAKER_THRESHOLD=3

# How long (ms) an open circuit stays open before a provider is tried again
# CIRCUIT_BREAKER_RESET_MS=60000

# --- Dashboard ---

# How long (ms) the model list read from the CLIs is cached before asking again (6h)
# SHELLM_MODEL_CATALOG_TTL_MS=21600000

# The short window the dashboard reports consumption over, in hours
# SHELLM_QUOTA_WINDOW_HOURS=5

# The long window the dashboard reports consumption over, in hours
# SHELLM_QUOTA_WEEK_HOURS=168

# --- Process ---

# `production` is what arms the guards: a weak admin password refuses to start and a
# run with no API keys logs CRITICAL. The systemd unit sets it; `shellm start -d` on a server
# does not.
# NODE_ENV=production

# Which ref `sudo shellm update` installs. A release tag, and only over SSH — see src/cli/update.js
# SHELLM_REF=
