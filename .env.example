# SheLLM configuration — the live copy is ~/.config/shellm/env (mode 600), written by `shellm init`.
# This file is a reference: nothing reads it at runtime.

# --- Server ---

# Port the HTTP server listens on
PORT=6100

# Interface to bind. Loopback keeps SheLLM reachable only through a local tunnel or proxy.
HOST=127.0.0.1

# Log level: debug, info, warn, error
LOG_LEVEL=info

# IANA timezone the admin dashboard renders every timestamp in — tables, charts and axis labels.
# Server logs stay UTC. An unknown name falls back to the default instead of failing.
# SHELLM_TZ=America/Mexico_City

# --- Providers ---

# Long-lived Claude token from `claude setup-token`. Optional when the CLI is logged in for this user.
# CLAUDE_CODE_OAUTH_TOKEN=

# Max time (ms) to wait for a CLI process before killing it
TIMEOUT_MS=120000

# Claude runs with --dangerously-skip-permissions so it never waits for a prompt.
# Set to false to remove the flag (a tool request will then hang until the timeout).
# SHELLM_CLAUDE_SKIP_PERMISSIONS=true

# --- Load ---

# Max CLI processes running at the same time. Requests beyond this wait in the queue;
# it limits subprocess spawns, not Express.
MAX_CONCURRENT=2

# Max requests waiting when every slot is busy. Beyond this, requests get HTTP 429.
MAX_QUEUE_DEPTH=10

# Max concurrent streaming responses (default: 2)
# MAX_STREAM_CONCURRENT=2

# Global rate limit across all API keys, requests per minute (default: 30)
# SHELLM_GLOBAL_RPM=30

# --- Auth ---

# Admin password for /admin/* and the dashboard login (generated by `shellm init`).
# When unset, every admin endpoint returns 501.
# SHELLM_ADMIN_PASSWORD=

# Only this username is accepted when set; otherwise any username with the right password works.
# SHELLM_ADMIN_USER=admin

# Failed admin logins per IP before a 5-minute lockout (default: 5)
# SHELLM_ADMIN_MAX_ATTEMPTS=5

# Reject /v1/* requests when no API key exists, instead of running unauthenticated (default: true)
# SHELLM_REQUIRE_AUTH=true

# HMAC secret for API key hashing. Auto-generated and stored in the database when unset;
# set it explicitly only to keep keys valid across a restore into a different database.
# SHELLM_HMAC_SECRET=

# --- Health and alerts ---

# How long (ms) provider health results are cached before re-probing
HEALTH_CACHE_TTL_MS=30000

# How often (ms) the background poller runs `--version` checks. Spends no quota.
# HEALTH_POLL_INTERVAL_MS=300000

# POST alerts (provider health transitions, auth failure spikes) to Slack, Discord, Uptime Kuma…
# SHELLM_ALERT_WEBHOOK_URL=

# Auth failures in one minute before the webhook fires (default: 10)
# SHELLM_AUTH_ALERT_THRESHOLD=10

# --- Routing (off by default) ---

# Retry a failed request on another provider, in priority order. Off unless set to true.
# SHELLM_FALLBACK_ENABLED=false
# SHELLM_FALLBACK_ORDER=claude,codex

# Consecutive failures before a provider's circuit opens, and how long (ms) it stays open.
# CIRCUIT_BREAKER_THRESHOLD=3
# CIRCUIT_BREAKER_RESET_MS=60000
