# Personal agent setup — only the paths the tools themselves define as local
CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/
.claude/agent-memory-local/

# Devcontainer: initialize.sh rewrites .host.env on every start; local.env is yours.
/.devcontainer/.host.env
/.devcontainer/.host.env.tmp
/.devcontainer/local.env

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# Credentials & tokens
config/secrets/
*.secret
auth-profiles.json
service.env
clients.json

# Node — no trailing slash: with one, the rule matches a directory and a symlink named
# node_modules slips past it, which is how an absolute one from a worktree reached master.
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data (all under data/)
data/

# Heartbeat (session-specific, not source)
HEARTBEAT.md

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Docs build output (tracked — needed for self-hosted /docs/ endpoint)

# Build & artifacts
*.tgz
*.tar.gz
*.zip

# n8n workflow exports with credentials
workflows/*.credentials.json

# Testing
coverage/

# Temporary
tmp/
temp/
scratchpad/
.tmp

docs/screens

# Design: local-only device captures, never committed (may hold real data)
design/references/

# Site: what the Pages workflow assembles into site/ at build time
site/assets/
site/img/
site/api/bundled.json
site/api/logo.svg
