                      "fontFamily": "$font-headline",
                      "fontSize": 10,
                      "fontWeight": "700",
                      "letterSpacing": 2
                    },
                    {
                      "type": "text",
                      "id": "HJE0q",
                      "name": "Note",
                      "fill": "$outline",
                      "content": "Pausing one takes it out of routing; it does not sign it out.",
