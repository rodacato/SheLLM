              "name": "Heading",
              "fill": "$primary-container",
              "content": "History",
              "fontFamily": "$font-headline",
              "fontSize": 11,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "i5s6h",
              "name": "Body",
              "fill": "$on-surface-variant",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "See the Log frame below this band.",
              "lineHeight": 1.6,
              "fontFamily": "$font-mono-render",
              "fontSize": 10,
              "fontWeight": "normal"
            }
          ]
        }
      ]
