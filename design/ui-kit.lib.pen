        {
          "type": "text",
          "id": "I8eGf",
          "name": "D20 note — the sign-in page keeps its own aliases",
          "fill": "$outline",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "D20 — the sign-in page (src/admin/login.js) does not read this palette. It ships a self-contained <style> with its own nine aliases (--bg, --panel, --line, --text, --accent, --error, --error-bg, --muted, --on-accent) so it renders when the rest of the admin cannot. A test pins each alias to the canonical value above, so the copy cannot drift while it exists. The kit mirrors that as it is and does not collapse the aliases into these names; whether to consolidate is open and Adrian's call.",
          "lineHeight": 1.6,
          "fontFamily": "Roboto Mono",
          "fontSize": 10,
          "fontWeight": "normal"
        }
      ]
    }
