{
  "name": "shellm",
  "version": "1.23.0",
  "license": "MIT",
  "description": "Your LLM services — unified as a REST API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodacato/SheLLM.git"
  },
  "main": "src/server.js",
  "bin": {
    "shellm": "src/cli.js"
  },
  "scripts": {
    "prepare": "git config core.hooksPath scripts 2>/dev/null || true",
    "version": "node scripts/release-changelog.js && git add CHANGELOG.md docs/api/openapi.yaml docs/api/bundled.json",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "catalog:build": "node scripts/build-model-catalog.js",
    "config:build": "node scripts/build-env-example.js",
    "brand:build": "node scripts/build-brand-assets.js",
    "brand:check": "node scripts/build-brand-assets.js --check",
    "brand:pack": "npm run brand:check && node scripts/build-brand-assets.js --kit && cd design/brand/dist && rm -f brand-kit.zip && zip -qr brand-kit.zip brand-kit",
    "migrate": "node -e \"require('./src/db').initDb()\"",
    "lint": "eslint src/ test/ scripts/",
    "lint:fix": "eslint --fix src/ test/ scripts/",
    "test": "node --experimental-test-module-mocks --test 'test/*.test.js' 'test/**/*.test.js'",
    "test:coverage": "mkdir -p coverage && node --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=85 --test-coverage-branches=78 --test-coverage-functions=85 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test 'test/*.test.js' 'test/**/*.test.js'",
    "test:e2e": "node --test --test-timeout 120000 test/e2e/*.e2e.js",
    "test:cli": "node --test --test-timeout 60000 test/cli/*.cli.js",
    "smoke": "node test/smoke.mjs",
    "conformance:record": "node --env-file-if-exists=.env.conformance test/conformance/record.js",
    "conformance:report": "node --env-file-if-exists=.env.conformance test/conformance/report.js",
    "audit:security": "node scripts/audit-deps.js",
    "docs:build": "redocly bundle docs/api/openapi.yaml --output docs/api/bundled.json --ext json",
    "docs:preview": "redocly preview docs/api/openapi.yaml",
    "docs:lint": "redocly lint docs/api/openapi.yaml"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.7",
    "express": "^5.2.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@redocly/cli": "^2.64.1",
    "@resvg/resvg-js": "2.6.2",
    "eslint": "^10.12.0",
    "openai": "^7.28.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
