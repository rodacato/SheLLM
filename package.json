{
  "name": "shellm",
  "version": "1.2.0",
  "license": "MIT",
  "description": "Your LLM services — unified as a REST API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodacato/SheLLM.git"
  },
  "main": "src/server.js",
  "bin": {
    "shellm": "src/cli.js"
  },
  "scripts": {
    "prepare": "git config core.hooksPath scripts 2>/dev/null || true",
    "version": "node scripts/release-changelog.js && git add CHANGELOG.md",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "migrate": "node -e \"require('./src/db').initDb()\"",
    "lint": "eslint src/ test/ scripts/",
    "lint:fix": "eslint --fix src/ test/ scripts/",
    "test": "node --experimental-test-module-mocks --test 'test/*.test.js' 'test/**/*.test.js'",
    "test:coverage": "node --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test 'test/*.test.js' 'test/**/*.test.js'",
    "test:e2e": "node --test --test-timeout 120000 test/e2e/*.e2e.js",
    "test:cli": "node --test --test-timeout 60000 test/cli/*.cli.js",
    "smoke": "node test/smoke.mjs",
    "audit:security": "node scripts/audit-deps.js",
    "docs:build": "redocly bundle docs/api/openapi.yaml --output docs/api/bundled.json --ext json",
    "docs:preview": "redocly preview docs/api/openapi.yaml",
    "docs:lint": "redocly lint docs/api/openapi.yaml"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@redocly/cli": "^2.53.2",
    "eslint": "^10.10.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
