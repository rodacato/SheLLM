[Unit]
Description=SheLLM - LLM CLI services unified as a REST API
After=network.target

[Service]
Type=simple
User=shellmer
WorkingDirectory=/home/shellmer/shellm
ExecStart=/usr/bin/node src/server.js
Environment=NODE_ENV=production NO_COLOR=1 LOG_LEVEL=info
Environment=PATH=/home/shellmer/.local/bin:/home/shellmer/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# The service must not be able to write the code it runs: the CLIs it spawns inherit this
# sandbox, and Restart=on-failure would reload anything they wrote. See docs/adr/0003.
ProtectSystem=strict
# The home is granted whole because the CLIs keep their state below it and rewrite
# ~/.claude.json by atomic rename, which needs the home itself writable.
ReadWritePaths=/home/shellmer
# Ignored while absent, so a missing tmpfiles entry leaves the update button inert
# rather than refusing to start the service.
ReadWritePaths=-/run/shellm
ReadOnlyPaths=/home/shellmer/shellm
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
